meta {
  name: partialupdate_booking
  type: http
  seq: 5
}

put {
  url: {{url}}/booking/{{BookingId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
      "firstname" : "Updated",
      "lastname" : "Updated",
      "totalprice" : 1,
      "depositpaid" : true,
      "bookingdates" : {
          "checkin" : "2018-01-01",
          "checkout" : "2019-01-01"
      },
      "additionalneeds" : "Breakfast"
  }
}

assert {
  res.status: eq 200
}
