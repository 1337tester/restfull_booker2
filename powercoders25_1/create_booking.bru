meta {
  name: create_booking
  type: http
  seq: 2
}

post {
  url: {{url}}/booking
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstname": "{{FirstName}}",
    "lastname": "{{LastName}}",
    "totalprice": 111,
    "depositpaid": true,
    "bookingdates": {
      "checkin": "2018-01-03",
      "checkout": "2019-01-01"
    },
    "additionalneeds": "Breakfast"
  }
}

assert {
  res.status: eq 418
}

script:pre-request {
  const customAlphabet = 'abcdefghijklmnopqrstuvwxyz';
  const customNanoid = require('nanoid').customAlphabet;
  const customSuffix = customNanoid(customAlphabet, 5);
  var suffix = customSuffix()
  
  // Generate random name-like strings
  const FirstName = "Jeanluck" + suffix
  const LastName = "Piccard" + suffix
  
  // Set variables for use in the request
  bru.setEnvVar("FirstName", FirstName);
  bru.setEnvVar("LastName", LastName);
  
  console.log(FirstName, LastName);
  
  
  // Simplified nanoid-like function for random string generation
  
}
